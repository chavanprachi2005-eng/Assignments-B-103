#Print all numbers between 1 and N that are divisible by 2
n = int(input("Enter N:"))
for i in range(1, n + 1 ):
    if i % 2 == 0:
        print(i)

#Print numbers from 1 to N, skipping numbers divisible by 3
n = int(input("Enter N: "))

for i in range(1, n + 1):
    if i % 3 == 0:
        continue
    print(i)

#Print numbers from 1 to N and stop when the number reaches 20
n = int(input("Enter N: "))

for i in range(1, n + 1):
    if i > 20:
        break
    print(i)

